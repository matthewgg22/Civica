# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Security
SNAP_FERNET_KEY=

# Sentry
SENTRY_DSN=

# T9: USPS address validation (optional; off unless "true")
ENABLE_ADDRESS_VALIDATION=false
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=

# T14: Twilio recertification outreach SMS
# Set RECERT_TWILIO_ENABLED=true in production to use LiveTwilioAdapter.
# When false (default), NoopTwilioAdapter is used — no credentials required.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1...
RECERT_TWILIO_ENABLED=false

# T15: AI-powered recert practice interview coaching
RECERT_AI_ENABLED=false
ANTHROPIC_API_KEY=

# T-DR3-8: Argyle webhook signature verification
# Optional — signature check is skipped when absent (safe for local dev).
# Production value: Argyle dashboard → Webhooks → Signing secret.
ARGYLE_WEBHOOK_SECRET=

# T-DR3-9: Canvas LMS OAuth proxy
# Required for schedule strip in JobMatchListView. Register a Developer Key
# in your Canvas instance: Admin → Developer Keys → + Developer Key → API Key.
# Redirect URI for local dev: http://localhost:8787/v1/enrollment/oauth/canvas/exchange
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_INSTANCE_URL=https://myschool.instructure.com
CANVAS_REDIRECT_URI=http://localhost:8787/v1/enrollment/oauth/canvas/exchange
