# Supabase — same project the iOS app + dashboard use.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...

# Server-side only — used by /api/lead-capture.
SUPABASE_SERVICE_ROLE_KEY=ey...

# Enrollment API gateway (Hono on Cloudflare Workers). The web client
# attaches the Supabase JWT it gets from phone OTP. Mirror of iOS's
# SNAP_ENROLLMENT_API_URL. The /v1/enrollment prefix is appended by
# the client — set the bare origin here.
NEXT_PUBLIC_ENROLLMENT_API_URL=https://enrollment-api.civica.example
