# Supabase — same project the iOS app + enrollment API use.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...

# Server-side only.
SUPABASE_SERVICE_ROLE_KEY=ey...

# TestFlight / App Store link shown in the AppDownloadIsland.
# Required for the island CTA on /cbo-preview to point to the real app.
# Falls back to https://testflight.apple.com/ when unset.
NEXT_PUBLIC_TESTFLIGHT_URL=https://testflight.apple.com/join/YOUR_CODE

# BenefitsCal autofill helper (Civica Submitter extension) install URL, shown on
# /cbo + /cbo/setup. Set to the unlisted Chrome Web Store listing once published;
# when unset the UI shows the pilot (load-unpacked) path instead.
# NEXT_PUBLIC_SUBMITTER_EXTENSION_URL=https://chrome.google.com/webstore/detail/<id>

# Feature flags
CBO_PREVIEW_ENABLED=true
