# Supabase (project settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SNAP enrollment PII encryption (Fernet key, 32 bytes base64-encoded)
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SNAP_FERNET_KEY=

# OpenAI (issue-brief, assistant/resolve endpoints)
OPENAI_API_KEY=
VOTENOW_OPENAI_MODEL=gpt-4o-mini
VOTENOW_ENABLE_OPENAI_ISSUE_BRIEF=true

# Safety hashing for brief_request.safety_identifier
# Generate: openssl rand -hex 32
VOTENOW_SAFETY_SALT=

# Signing secret for OCR webhook payloads
# Generate: openssl rand -hex 32
OCR_WEBHOOK_SECRET=

# Sentry error monitoring
# Create a project at sentry.io, then copy the DSN from Settings → Client Keys.
# Leave blank in dev to disable Sentry; initSentry() is a no-op when unset.
SENTRY_DSN=
# Temporarily set to "1" to enable GET /debug/sentry-check for staging verification; unset after.
SENTRY_CHECK_ENABLED=

# App
PORT=3001
NODE_ENV=development
