{
  "name": "@civica/api",
  "private": true,
  "version": "0.0.0",
  "description": "Hono API gateway for SNAP. Owns auth, audit, rate limiting, OpenAPI, navigator endpoints. Proxies applicant flows to the FastAPI engine in backend/.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.10",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.5"
  }
}
