    "find_help.disclaimer.call_ahead": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call ahead to confirm hours and services. Listings are not endorsements."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llame antes para confirmar horarios y servicios. Los listados no son recomendaciones."
          }
        }
      }
    },
    "find_help.disclosure.full": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Civica is not affiliated with the U.S. Department of Agriculture or any state SNAP agency. Locations are sourced from authoritative public directories and may be out of date. Call ahead before visiting to confirm hours and services. To apply for SNAP through official channels, contact your state SNAP agency or call 1-800-221-5689."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Civica no está afiliada al Departamento de Agricultura de EE. UU. ni a ninguna agencia estatal de SNAP. Las ubicaciones provienen de directorios públicos autorizados y pueden estar desactualizadas. Llame antes de visitar para confirmar horarios y servicios. Para solicitar SNAP a través de canales oficiales, comuníquese con la agencia SNAP de su estado o llame al 1-800-221-5689."
          }
        }
      }
    },
    "find_help.disclosure.short": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Civica is not affiliated with USDA or any state SNAP agency. Tap for sources."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Civica no está afiliada al USDA ni a ninguna agencia estatal de SNAP. Toque para ver las fuentes."
          }
        }
      }
    },
