// Template for Secrets.xcconfig — copy to Secrets.xcconfig and fill in real values.
// Secrets.xcconfig is gitignored; this template is committed as a setup guide.

ADMIN_PIN = 000000

// Sentry DSN for the Civica iOS project. Leave blank to disable Sentry in this
// build (init becomes a no-op). Operators paste the public project DSN here for
// dogfood / TestFlight / App Store builds.
CIVICA_SENTRY_DSN =

// Sentry org + project slugs for the dSYM upload build phase. Default to
// the apple-ios project on the civica-gl org; override here if a future
// rename happens.
SENTRY_ORG_SLUG = civica-gl
SENTRY_PROJECT_SLUG = apple-ios
