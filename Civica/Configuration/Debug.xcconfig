// Debug build settings for the Civica target.
// Secret values (ADMIN_PIN, CIVICA_SENTRY_DSN, etc.) come from Secrets.xcconfig
// which is gitignored. Copy Secrets.xcconfig.template to Secrets.xcconfig and
// fill in values before building.
//
// CIVICA_SENTRY_DSN: when empty, the iOS Sentry init is skipped — see
// Civica/App/Observability/CivicaSentry.swift.

ADMIN_PIN = 000000
CIVICA_SENTRY_DSN =

// Sentry org + project slugs for dSYM upload (see
// scripts/upload-sentry-dsyms.sh). Debug builds skip the upload phase
// entirely, but the vars must be declared so xcconfig resolution does
// not warn. Real values live in Secrets.xcconfig (operator-controlled).
SENTRY_ORG_SLUG = civica-gl
SENTRY_PROJECT_SLUG = apple-ios

#include? "Secrets.xcconfig"
