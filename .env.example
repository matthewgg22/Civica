# Copy to .env.local and fill in.
# Vars consumed by apps/api (Hono gateway) unless noted otherwise.

# === Runtime ===
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# === Database ===
# Host-local default; compose overrides to postgres://civica:civica@postgres:5432/civica_dev
DATABASE_URL=postgres://civica:civica@127.0.0.1:5432/civica_dev

# === FastAPI engine sidecar ===
# Where the gateway reaches the engine. Local dev (uvicorn on host):
ENGINE_BASE_URL=http://127.0.0.1:8000
# Shared HMAC secret signing every internal gateway -> engine request (Phase 12).
# Generate with: openssl rand -hex 32
INTERNAL_HMAC_SECRET=replace-me-32-byte-secret

# === Supabase Auth (Phase 6) ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# HS256 secret for verifying both applicant and staff JWTs.
# Found at: Supabase dashboard → Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=

# === Rate limiting (Phase 11) ===
# Optional. When unset, an in-memory token bucket is used (per-process).
# REDIS_URL=redis://127.0.0.1:6379

# === OCR webhook (Phase 15, future Textract/Document AI path) ===
# OCR_WEBHOOK_HMAC_SECRET=

# === Sentry (snap-api, snap-engine) ===
# Create projects at sentry.io. Leave blank in dev to disable (no-op).
SENTRY_DSN=
# Temporarily set to "1" to enable /debug/sentry-check for staging verification; unset after.
SENTRY_CHECK_ENABLED=

# === T9 state-connectors (USPS address validation, optional) ===
# Off unless ENABLE_ADDRESS_VALIDATION=true. Register an OAuth 2 app at
# https://developer.usps.com to obtain the client id/secret. In production
# the secrets live in `wrangler secret put` for the enrollment-api Worker.
ENABLE_ADDRESS_VALIDATION=
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=

# ======================================================================
# Engine-only vars (backend/, FastAPI). NOT loaded by Hono. Listed here
# for visibility — set in the engine's own env file.
# ======================================================================
# SUPABASE_SERVICE_ROLE_KEY=
# SNAP_FERNET_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ======================================================================
# Analytical tier (T10) — Supabase Storage S3 creds for DuckDB.
# Used by @civica/analytics-engine (server runtimes) and scripts/sync-to-supabase-storage.ts.
# Generate at: Supabase dashboard → Project Settings → Storage → S3 Connection.
# See docs/data-architecture.md § DuckDB credentials.
# ======================================================================
SUPABASE_S3_ENDPOINT=https://your-project.supabase.co/storage/v1/s3
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET=
SUPABASE_S3_REGION=us-east-1

# Gate /tools/cliff-preview (T10 proof-of-life). Unset in prod.
ENABLE_ANALYTICS_PREVIEW=
