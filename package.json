{
  "name": "civica",
  "version": "0.0.0",
  "private": true,
  "description": "Civica monorepo: iOS (Civica + VoteNow Xcode targets), web-b2c, navigator dashboard, Hono API, shared packages.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build --filter=!snap-verification-prototype",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "data:sync": "tsx scripts/sync-to-supabase-storage.ts",
    "data:build:section-10105": "tsx data-ops/parsers/section_10105_to_parquet.ts",
    "data:build:cfr-273": "tsx packages/cfr-273/scripts/build-parquet.ts",
    "data:build:qc-mapping": "tsx data-ops/parsers/qc_category_mapping_to_parquet.ts",
    "data:report:baseline": "tsx scripts/generate-baseline-report.ts"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "@duckdb/node-api": "^1.1.3-alpha.7",
    "tsx": "^4.19.2",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "overrides": {
      "snap-verification-prototype>@types/react": "18.3.3",
      "snap-verification-prototype>@types/react-dom": "18.3.0"
    }
  }
}
