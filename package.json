{
  "name": "civica",
  "version": "0.0.0",
  "private": true,
  "description": "Civica monorepo: iOS (Civica + VoteNow Xcode targets), web-b2c, navigator dashboard, Hono API, shared packages.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
