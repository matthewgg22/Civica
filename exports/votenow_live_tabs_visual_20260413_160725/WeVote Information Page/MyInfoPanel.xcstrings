    "my_info.alert.invalid_zip.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enter a valid U.S. ZIP, city/state, or full address before continuing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingresa un ZIP de EE. UU., ciudad/estado o direccion completa validos antes de continuar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续之前请输入有效的美国邮编、城市/州或完整地址。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maglagay ng wastong U.S. ZIP, lungsod/estado, o buong address bago magpatuloy."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vui lòng nhập ZIP Hoa Kỳ, thành phố/tiểu bang hoặc địa chỉ đầy đủ hợp lệ trước khi tiếp tục."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "继续之前请输入有效的美国邮编、城市/州或完整地址。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enter a valid U.S. ZIP, city/state, or full address before continuing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enter a valid U.S. ZIP, city/state, or full address before continuing."
          }
        }
      }
    },
