{
  "$schema_version": 1,
  "title": "SNAP engines — internal test scenarios (MA pilot 2026-06)",
  "description": "Declarative scenarios consumed by both runners: TS (probability) via `pnpm --filter @civica/snap-qc-engine cli batch`, and Swift (eligibility) via the SNAPEngineBatchScenariosTests suite. Update this file to add or pin a new invariant; both runners adapt automatically.",
  "as_of_date": "2026-03-15",

  "probability": [
    {
      "id": "qc-ca-strong-packet",
      "state": "CA",
      "kind": "score-packet",
      "description": "Score floor — all-strong packet must hit tier=low, score=5",
      "input": {
        "packet": [
          { "flow": "utility-sua", "defensibility_score": "strong" },
          { "flow": "gig-income", "defensibility_score": "strong" },
          { "flow": "shared-lease", "defensibility_score": "strong" },
          { "flow": "assets", "defensibility_score": "strong" },
          { "flow": "benefit-impact-projection", "defensibility_score": "strong" }
        ]
      },
      "expected": {
        "tier": "low",
        "score": 5,
        "factors_count": 0
      }
    },
    {
      "id": "qc-ca-weak-packet",
      "state": "CA",
      "kind": "score-packet",
      "description": "Score ceiling — all-weak packet must hit tier=high, score=80",
      "input": {
        "packet": [
          { "flow": "utility-sua", "defensibility_score": "weak" },
          { "flow": "gig-income", "defensibility_score": "weak" },
          { "flow": "shared-lease", "defensibility_score": "weak" }
        ]
      },
      "expected": {
        "tier": "high",
        "score": 80,
        "factors_count": 3
      }
    },
    {
      "id": "qc-ca-mixed-packet",
      "state": "CA",
      "kind": "score-packet",
      "description": "Mixed packet — moderate-tier with 1 weak surfaced as factor",
      "input": {
        "packet": [
          { "flow": "utility-sua", "defensibility_score": "moderate" },
          { "flow": "gig-income", "defensibility_score": "weak" },
          { "flow": "shared-lease", "defensibility_score": "strong" }
        ]
      },
      "expected": {
        "tier": "medium",
        "score": 49,
        "factors_count": 1
      }
    },
    {
      "id": "qc-ca-full-engagement",
      "state": "CA",
      "kind": "population-per",
      "description": "CA at 100% engagement reaches thesis target 5.5% projected PER",
      "input": {
        "coverage": {
          "utility_sua": 1.0,
          "gig_income": 1.0,
          "shared_lease": 1.0,
          "assets": 1.0,
          "benefit_impact": 1.0
        }
      },
      "expected": {
        "projected_per": 5.50,
        "tolerance": 0.05
      }
    },
    {
      "id": "qc-ma-full-engagement",
      "state": "MA",
      "kind": "population-per",
      "description": "MA at 100% engagement scales proportionally: 14.10 × (5.5/10.98) ≈ 7.06%",
      "input": {
        "coverage": {
          "utility_sua": 1.0,
          "gig_income": 1.0,
          "shared_lease": 1.0,
          "assets": 1.0,
          "benefit_impact": 1.0
        }
      },
      "expected": {
        "projected_per": 7.06,
        "tolerance": 0.05
      }
    }
  ],

