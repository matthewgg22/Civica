    "app.registration.provisional.request.step_1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Tell the poll worker: “I want to vote by provisional ballot.”"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Dile al trabajador electoral: “Quiero votar con provisional ballot.”"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Sabihin sa poll worker: “I want to vote by provisional ballot.”"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Nói với nhân viên điểm bỏ phiếu: “I want to vote by provisional ballot.”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 告诉工作人员：“I want to vote by provisional ballot.”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 告诉工作人员：“I want to vote by provisional ballot.”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Tell the poll worker: “I want to vote by provisional ballot.”"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Tell the poll worker: “I want to vote by provisional ballot.”"
          }
        }
      }
    },
    "app.registration.provisional.request.step_2.reindexed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Complete the provisional ballot envelope carefully and provide any requested ID details."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Completa cuidadosamente el sobre de provisional ballot y proporciona cualquier dato de ID solicitado."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Maingat na kumpletuhin ang sobre ng provisional ballot at ibigay ang anumang hinihinging detalye ng ID."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Điền cẩn thận phong bì provisional ballot và cung cấp mọi thông tin ID được yêu cầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 仔细填写provisional ballot信封，并提供所需ID信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 仔细填写provisional ballot信封，并提供所需ID信息。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Complete the provisional ballot envelope carefully and provide any requested ID details."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Complete the provisional ballot envelope carefully and provide any requested ID details."
          }
        }
      }
    },
    "app.registration.provisional.request.step_3.reindexed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a receipt or tracking and confirm cure deadlines before leaving."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Pide un recibo o método de seguimiento y confirma cualquier plazo de corrección antes de irte."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Humingi ng resibo o paraan ng pagsubaybay at kumpirmahin ang anumang cure deadline bago umalis."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Yêu cầu biên nhận hoặc cách theo dõi và xác nhận mọi hạn chót sửa lỗi trước khi rời đi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 索取回执或追踪方式，并在离开前确认任何补救截止日期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 索取回执或追踪方式，并在离开前确认任何补救截止日期。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a receipt or tracking and confirm cure deadlines before leaving."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a receipt or tracking and confirm cure deadlines before leaving."
          }
        }
      }
    },
