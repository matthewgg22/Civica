    "app.guide.card.special.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Special elections fill vacancies or decide urgent ballot questions outside the normal election calendar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las elecciones especiales cubren vacantes o deciden asuntos urgentes de la boleta fuera del calendario electoral normal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "特别选举用于填补空缺职位，或在常规选举日程之外决定紧急议题。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang special election ay para punan ang bakanteng puwesto o pagdesisyunan ang mahahalagang usapin sa balota sa labas ng regular na kalendaryo ng halalan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bầu cử đặc biệt dùng để lấp chỗ trống chức vụ hoặc quyết định các vấn đề khẩn cấp ngoài lịch bầu cử thông thường."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "特别选举用于填补空缺职位，或在常规选举日程之外决定紧急议题。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Special elections fill vacancies or decide urgent ballot questions outside the normal election calendar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Special elections fill vacancies or decide urgent ballot questions outside the normal election calendar."
          }
        }
      }
    },
