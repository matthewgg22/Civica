    "app.registration.card.what_is.bullet_1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most states require registration before you can vote."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mayoría de los estados exige registro antes de votar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大多数州要求先登记后投票。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Karamihan sa mga estado ay nangangailangan ng rehistro bago ka makaboto."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hầu hết các bang yêu cầu đăng ký trước khi bạn có thể bỏ phiếu."
          }
        }
      }
    },
    "app.registration.card.what_is.bullet_2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking early helps prevent Election Day surprises."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificar con anticipación ayuda a evitar sorpresas el día de la elección."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尽早确认可避免选举日意外。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang maagang pag-check ay nakakatulong para maiwasan ang aberya sa Araw ng Halalan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra sớm giúp tránh bất ngờ vào Ngày bầu cử."
          }
        }
      }
    },
    "app.registration.card.what_is.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voter registration is the process that puts you on your state’s voter rolls so you are eligible to vote."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro de votantes es el proceso que te incluye en el padrón de tu estado para que puedas votar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选民登记是将你加入本州选民名册、使你具备投票资格的流程。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang voter registration ang prosesong naglalagay sa iyo sa listahan ng mga botante ng estado upang maging karapat-dapat kang bumoto."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng ký cử tri là quy trình đưa bạn vào danh sách cử tri của bang để đủ điều kiện bỏ phiếu."
          }
        }
      }
    },
    "app.registration.card.what_is.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is Voter Registration?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué es el registro de votantes?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "什么是选民登记？"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ano ang Voter Registration?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng ký cử tri là gì?"
          }
        }
      }
    },
