    "app.guide.card.party_affiliation.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Democratic and Republican parties are the two largest in the United States. In many states, primary ballot eligibility depends on your current party registration. Example: in a closed primary, a voter registered as Independent may not be able to vote in either the Democratic or Republican primary unless they change party registration before the state deadline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La elegibilidad para la boleta primaria puede depender de tu afiliación partidaria actual. Confirma las reglas de tu estado antes del día de la elección."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "初选选票资格可能取决于你当前的政党登记。请在选举日前确认所在州规则。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaaring nakadepende sa kasalukuyan mong rehistro sa partido ang pagiging karapat-dapat sa primary ballot. Kumpirmahin ang mga tuntunin ng inyong estado bago ang araw ng halalan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều kiện nhận lá phiếu sơ bộ có thể phụ thuộc vào đăng ký đảng hiện tại của bạn. Hãy xác nhận quy định của bang trước ngày bầu cử."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "初选选票资格可能取决于你当前的政党登记。请在选举日前确认所在州规则。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "The Democratic and Republican parties are the two largest in the United States. In many states, primary ballot eligibility depends on your current party registration. Example: in a closed primary, a voter registered as Independent may not be able to vote in either the Democratic or Republican primary unless they change party registration before the state deadline."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "The Democratic and Republican parties are the two largest in the United States. In many states, primary ballot eligibility depends on your current party registration. Example: in a closed primary, a voter registered as Independent may not be able to vote in either the Democratic or Republican primary unless they change party registration before the state deadline."
          }
        }
      }
    },
