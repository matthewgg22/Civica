    "app.mapv.absentee.what_absentee.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Absentee voting is a mail-ballot process typically used when you cannot vote in person. Rules and eligibility vary by jurisdiction."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El voto en ausencia es un proceso de boleta por correo que normalmente se usa cuando no puedes votar en persona. Las reglas y la elegibilidad varían según la jurisdicción."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺席投票通常用于你无法到场投票时的邮寄选票流程。规则和资格因辖区而异。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang absentee voting ay proseso ng mail ballot na karaniwang ginagamit kapag hindi ka makakaboto nang personal. Nagkakaiba ang tuntunin at pagiging kwalipikado ayon sa hurisdiksyon."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ phiếu vắng mặt là quy trình phiếu qua thư thường dùng khi bạn không thể bỏ phiếu trực tiếp. Quy tắc và điều kiện khác nhau theo khu vực."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "缺席投票通常用于你无法到场投票时的邮寄选票流程。规则和资格因辖区而异。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Absentee voting is a mail-ballot process typically used when you cannot vote in person. Rules and eligibility vary by jurisdiction."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Absentee voting is a mail-ballot process typically used when you cannot vote in person. Rules and eligibility vary by jurisdiction."
          }
        }
      }
    },
