    "app.guide.card.midterm.body.reused_offices": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is on the ballot: all U.S. House seats, some U.S. Senate seats, many governor and state legislature races, and statewide/local ballot measures where scheduled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué aparece en la boleta: todos los escaños de la Cámara de Representantes de EE. UU., algunos del Senado, muchas contiendas para gobernador y legislaturas estatales, y medidas de boleta estatales/locales donde correspondan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nilalaman ng balota: lahat ng puwesto sa U.S. House, ilang puwesto sa U.S. Senate, maraming laban para sa gobernador at state legislature, at mga panrehiyon/lokal na panukala sa balota kung naka-iskedyul."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên lá phiếu có: toàn bộ ghế Hạ viện Hoa Kỳ, một số ghế Thượng viện Hoa Kỳ, nhiều cuộc đua thống đốc và nghị viện bang, cùng các sáng kiến toàn bang/địa phương theo lịch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选票内容包括全部联邦众议院席位、部分联邦参议院席位、许多州长与州议会选举，以及按安排进行的州/地方公投。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選票內容包括全部聯邦眾議院席位、部分聯邦參議院席位、許多州長與州議會選舉，以及按安排進行的州／地方公投。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bulletin comprend : tous les sièges de la Chambre des représentants, certains sièges du Sénat, de nombreuses élections de gouverneur et de législatures d’État, ainsi que des mesures référendaires locales et à l’échelle de l’État selon le calendrier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Stimmzettel stehen: alle Sitze im US-Repräsentantenhaus, einige Sitze im US-Senat, viele Wahlen für Gouverneur und Landesparlamente sowie landesweite/lokale Abstimmungsfragen je nach Terminplan."
          }
        }
      }
    },
