    "app.sample_ballot.ranked_choice.body_1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This sample is structured for ranked-choice voting, so you can set your candidate order now before entering the voting booth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta muestra está estructurada para voto por orden de preferencia, para que puedas definir el orden de tus candidatos antes de votar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该样本采用排序选择投票结构，你可以在进入投票站前先设置候选人顺序。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang sample na ito ay para sa ranked-choice voting para maayos mo na ang pagkakasunod ng kandidato bago pumasok sa botohan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mẫu này được thiết kế cho bỏ phiếu xếp hạng, để bạn có thể sắp thứ tự ứng viên trước khi vào điểm bỏ phiếu."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "该样本采用排序选择投票结构，你可以在进入投票站前先设置候选人顺序。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "This sample is structured for ranked-choice voting, so you can set your candidate order now before entering the voting booth."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "This sample is structured for ranked-choice voting, so you can set your candidate order now before entering the voting booth."
          }
        }
      }
    },
