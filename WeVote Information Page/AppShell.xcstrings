    "app.guide.card.runoff.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A runoff election happens when no candidate reaches the required threshold in the first primary round."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una segunda vuelta ocurre cuando ningún candidato alcanza el umbral requerido en la primera ronda primaria."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若首轮初选中无人达到法定门槛，就会举行决选。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagaganap ang runoff election kapag walang kandidatong umabot sa kinakailangang threshold sa unang round ng primary."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bầu cử vòng hai diễn ra khi không ứng viên nào đạt ngưỡng yêu cầu ở vòng sơ bộ đầu tiên."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若首轮初选中无人达到法定门槛，就会举行决选。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "A runoff election happens when no candidate reaches the required threshold in the first primary round."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "A runoff election happens when no candidate reaches the required threshold in the first primary round."
          }
        }
      }
    },
