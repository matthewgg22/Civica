          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Runoff elections are held when no candidate reaches the required threshold in the primary."
          }
        }
      }
    },
    "app.timeline.ballot.independent.note.with_type": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Independent voters in %@ should expect %@ primary rules. Final primary ballot access can still vary by party rules, so verify with your state election office."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los votantes Independent en %@ deben esperar reglas de primary de tipo %@. El acceso final a la boleta primary aún puede variar por reglas partidarias, así que verifica con la oficina electoral de tu estado."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang mga Independent voter sa %@ ay dapat asahan ang %@ na primary rules. Maaaring mag-iba pa rin ang final primary ballot access ayon sa party rules, kaya i-verify sa opisina ng halalan ng estado."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cử tri Independent tại %@ nên kỳ vọng quy tắc primary dạng %@. Quyền truy cập phiếu primary cuối cùng vẫn có thể khác theo quy tắc đảng, vì vậy hãy xác minh với văn phòng bầu cử bang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@的Independent选民应预期%@类型的primary规则。最终的primary选票资格仍可能因党派规则而异，请向州选举办公室核实。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@的Independent选民应预期%@类型的primary规则。最终的primary选票资格仍可能因党派规则而异，请向州选举办公室核实。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Independent voters in %@ should expect %@ primary rules. Final primary ballot access can still vary by party rules, so verify with your state election office."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Independent voters in %@ should expect %@ primary rules. Final primary ballot access can still vary by party rules, so verify with your state election office."
          }
        }
      }
    },
