    "app.mapv.absentee.what_mail_in.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is mail-in voting?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué es la votación por correo?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "什么是邮寄投票？"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ano ang mail-in voting?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ phiếu qua thư là gì?"
          }
        }
      }
    },
    "app.mapv.absentee.what_mail_in.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail-in voting lets eligible voters receive a ballot and return it by mail or approved drop-off methods. Some states mail ballots automatically, while others require a request."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La votación por correo permite que las personas elegibles reciban una boleta y la devuelvan por correo o mediante métodos de entrega autorizados. Algunos estados envían boletas automáticamente y otros requieren una solicitud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邮寄投票允许符合资格的选民收到选票，并通过邮寄或指定投递方式寄回。有些州会自动寄送选票，另一些州则需要申请。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinapayagan ng mail-in voting ang karapat-dapat na botante na makatanggap ng balota at ibalik ito sa koreo o aprubadong drop-off. May mga estadong awtomatikong nagpapadala ng balota, at may ibang nangangailangan ng request."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ phiếu qua thư cho phép cử tri đủ điều kiện nhận phiếu và gửi lại qua thư hoặc điểm nộp được chấp thuận. Một số bang gửi phiếu tự động, số khác yêu cầu nộp đơn."
          }
        }
      }
    },
    "app.mapv.absentee.what_absentee.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is absentee voting?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué es el voto en ausencia?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "什么是缺席投票？"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ano ang absentee voting?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ phiếu vắng mặt là gì?"
          }
        }
      }
    },
    "app.mapv.absentee.what_absentee.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Absentee voting is a mail-ballot process typically used when you cannot vote in person. Rules and eligibility vary by jurisdiction."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El voto en ausencia es un proceso de boleta por correo que normalmente se usa cuando no puedes votar en persona. Las reglas y la elegibilidad varían según la jurisdicción."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺席投票通常用于你无法到场投票时的邮寄选票流程。规则和资格因辖区而异。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang absentee voting ay proseso ng mail ballot na karaniwang ginagamit kapag hindi ka makakaboto nang personal. Nagkakaiba ang tuntunin at pagiging kwalipikado ayon sa hurisdiksyon."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ phiếu vắng mặt là quy trình phiếu qua thư thường dùng khi bạn không thể bỏ phiếu trực tiếp. Quy tắc và điều kiện khác nhau theo khu vực."
          }
        }
      }
    },
