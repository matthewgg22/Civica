    "app.feedback.college_endeavor.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "College Student Endeavor"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Proyecto universitario"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大学生项目"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Proyektong Pang‑kolehiyo"
          }
        },
        "vi": {
