    "app.guide.card.overview.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This guide is personalized to your next upcoming election based on your current ZIP and state."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta guía está personalizada para tu próxima elección según tu código postal y estado actuales."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本指南基于你当前的邮编和州，个性化显示你下一场即将到来的选举信息。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang gabay na ito ay naka-personalize para sa susunod mong halalan batay sa kasalukuyan mong ZIP at estado."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hướng dẫn này được cá nhân hóa cho kỳ bầu cử sắp tới của bạn dựa trên ZIP và bang hiện tại."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本指南基于你当前的邮编和州，个性化显示你下一场即将到来的选举信息。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "This guide is personalized to your next upcoming election based on your current ZIP and state."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "This guide is personalized to your next upcoming election based on your current ZIP and state."
          }
        }
      }
    },
