    "app.registration.card.check.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your state’s official voter lookup to verify your registration details are active and accurate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la herramienta oficial de consulta de votantes de tu estado para verificar que tu registro esté activo y correcto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你所在州的官方选民查询工具，确认你的登记信息处于有效且准确状态。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamitin ang opisyal na voter lookup ng iyong estado para tiyaking aktibo at tama ang iyong detalye sa rehistro."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng công cụ tra cứu cử tri chính thức của bang để xác minh thông tin đăng ký đang hoạt động và chính xác."
          }
        }
      }
    },
