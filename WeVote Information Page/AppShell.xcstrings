    "app.support_vote.disrupt.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disrupt the Status Quo by empowering voters, not campaigns."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rompe el status quo empoderando a los votantes, no a las campañas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过赋能选民而非竞选，打破现状。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Baguhin ang status quo sa pag-empower ng botante, hindi kampanya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phá vỡ hiện trạng bằng cách trao quyền cho cử tri, không phải chiến dịch."
          }
        }
      }
    },
    "app.support_vote.disrupt.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most voter outreach in America is not funded by voters. It is funded by PACs and Super PACs. That means:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mayor parte del alcance electoral en EE. UU. no es financiada por votantes, sino por PACs y Super PACs. Eso significa:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "美国多数选民触达并非由选民资助，而是由 PAC 和超级 PAC 资助。这意味着："
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Karamihan sa voter outreach sa Amerika ay hindi pinopondohan ng mga botante. Pinopondohan ito ng PACs at Super PACs. Ibig sabihin:"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phần lớn hoạt động vận động cử tri ở Mỹ không do cử tri tài trợ mà do PACs và Super PACs tài trợ. Điều đó có nghĩa là:"
          }
        }
      }
    },
    "app.support_vote.disrupt.bullet_1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messaging is designed to move votes for a side"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes se diseñan para mover votos hacia un lado"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "信息传递往往服务于某一方的拉票目标"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinisenyo ang messaging para ilipat ang boto sa isang panig"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông điệp được thiết kế để kéo phiếu cho một phía"
          }
        }
      }
    },
    "app.support_vote.disrupt.bullet_2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Outreach spikes where races are close (and money is flowing)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La difusión aumenta donde las contiendas están cerradas (y donde fluye el dinero)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "竞争激烈、资金密集地区会出现更高触达"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumataas ang outreach kung saan dikit ang laban (at may daloy ng pera)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoạt động vận động tăng mạnh ở nơi cuộc đua sít sao (và tiền đổ vào)"
          }
        }
      }
    },
    "app.support_vote.disrupt.bullet_3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voters become targets, not long-term users"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los votantes se vuelven objetivos, no usuarios a largo plazo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选民变成“目标对象”，而非长期服务对象"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagiging target ang mga botante, hindi pangmatagalang users"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cử tri trở thành mục tiêu, không phải người dùng dài hạn"
          }
        }
      }
    },
    "app.support_vote.disrupt.bullet_4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system optimizes for winning - not serving"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sistema se optimiza para ganar, no para servir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统优化的是“赢”，而不是“服务”"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang sistema ay naka-optimize para manalo — hindi para maglingkod"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hệ thống tối ưu để thắng — không phải để phục vụ"
          }
        }
      }
    },
    "app.support_vote.disrupt.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VoteNow is built around servicing YOU, the voter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "VoteNow está construido para servirte a TI, votante."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VoteNow 的设计核心是服务你这位选民。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang VoteNow ay ginawa para maglingkod sa IYO, ang botante."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "VoteNow được xây dựng để phục vụ BẠN, người cử tri."
