    "app.why_vote.hero.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When turnout drops, the people who show up decide more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando baja la participación, quienes sí votan deciden más."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag mas mababa ang turnout, mas malaki ang pasya ng mga bumoboto."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi turnout thấp hơn, những người đi bỏ phiếu sẽ quyết định nhiều hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当投票率下降时，去投票的人决定更多。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "当投票率下降时，去投票的人决定更多。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "When turnout drops, the people who show up decide more."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "When turnout drops, the people who show up decide more."
          }
        }
      }
    },
