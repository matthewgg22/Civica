    "app.why_vote.takeaway.bold": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your vote can shift turnout."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu voto puede cambiar la participación."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的选票可以改变投票率。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayang baguhin ng boto mo ang turnout."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lá phiếu của bạn có thể thay đổi tỷ lệ đi bầu."
          }
        }
      }
    },
    "app.why_vote.takeaway.full": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In %@, about %@ voted in the last presidential election, but only %@ voted in the last midterm. That means many eligible voters sat out, even though close races can be decided by tiny margins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En %@, aproximadamente %@ votó en la última elección presidencial, pero solo %@ votó en la última elección de mitad de período. Eso significa que muchos votantes elegibles no participaron, aunque las contiendas cerradas pueden decidirse por márgenes mínimos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %@，最近一次总统选举的投票率约为 %@，但最近一次中期选举只有 %@。这意味着很多合格选民没有投票，而胶着选举往往由微小差距决定。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa %@, humigit-kumulang %@ ang bumoto sa huling presidential election, pero %@ lang sa huling midterm. Ibig sabihin, maraming kwalipikadong botante ang hindi nakaboto, kahit na maliliit na agwat lang ang puwedeng magpasya sa dikit na laban."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tại %@, khoảng %@ đã đi bầu trong kỳ tổng thống gần nhất, nhưng chỉ %@ trong kỳ giữa nhiệm kỳ gần nhất. Điều đó nghĩa là nhiều cử tri đủ điều kiện đã không đi bầu, dù các cuộc đua sít sao có thể được quyết định bởi chênh lệch rất nhỏ."
          }
        }
      }
    },
    "app.why_vote.takeaway.limited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In %@, some turnout fields are not available in this summary. Even with incomplete data, close-race history shows that small vote shifts can change results."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En %@, algunos campos de participación no están disponibles en este resumen. Incluso con datos incompletos, el historial de contiendas cerradas muestra que pequeños cambios de voto pueden cambiar resultados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %@，本摘要中的部分投票率字段暂不可用。即使数据不完整，胶着选举历史仍表明小幅投票变化会改变结果。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa %@, may ilang turnout fields na hindi available sa buod na ito. Kahit kulang ang datos, ipinapakita ng history ng close races na puwedeng magbago ang resulta sa maliliit na pagbabago sa boto."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tại %@, một số trường dữ liệu turnout chưa có trong phần tóm tắt này. Dù dữ liệu chưa đầy đủ, lịch sử các cuộc đua sít sao cho thấy thay đổi nhỏ về phiếu bầu có thể đổi kết quả."
          }
        }
      }
    },
    "app.why_vote.takeaway.mid_only": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In %@, turnout was about %@ in the last midterm election. Presidential participation data in this summary is limited, but close races can still be decided by tiny margins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En %@, la participación fue de aproximadamente %@ en la última elección de mitad de período. Los datos presidenciales en este resumen son limitados, pero las contiendas cerradas aún pueden decidirse por márgenes mínimos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %@，最近一次中期选举投票率约为 %@。本摘要中的总统选举参与数据有限，但胶着选举仍可能由微小差距决定。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa %@, humigit-kumulang %@ ang turnout sa huling midterm election. Limitado ang presidential participation data sa buod na ito, ngunit puwedeng magdesisyon ang maliliit na agwat sa close races."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tại %@, turnout ở kỳ giữa nhiệm kỳ gần nhất khoảng %@. Dữ liệu tham gia ở kỳ tổng thống trong phần tóm tắt này còn hạn chế, nhưng các cuộc đua sít sao vẫn có thể được quyết định bởi chênh lệch nhỏ."
          }
        }
      }
    },
    "app.why_vote.takeaway.pres_only": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In %@, turnout reached about %@ in the last presidential election. Midterm participation data in this summary is limited, but close-race history still shows that small vote shifts can change results."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En %@, la participación alcanzó aproximadamente %@ en la última elección presidencial. Los datos de mitad de período en este resumen son limitados, pero el historial de contiendas cerradas muestra que pequeños cambios de voto pueden cambiar resultados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %@，最近一次总统选举投票率约为 %@。本摘要中的中期选举参与数据有限，但胶着选举历史仍表明小幅投票变化会改变结果。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa %@, umabot sa humigit-kumulang %@ ang turnout sa huling presidential election. Limitado ang midterm participation data sa buod na ito, ngunit ipinapakita pa rin ng close-race history na ang maliliit na paglipat ng boto ay nakababago ng resulta."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tại %@, turnout đạt khoảng %@ trong kỳ tổng thống gần nhất. Dữ liệu tham gia giữa nhiệm kỳ trong phần tóm tắt này còn hạn chế, nhưng lịch sử các cuộc đua sít sao vẫn cho thấy dịch chuyển nhỏ về phiếu có thể đổi kết quả."
          }
        }
      }
    },
    "app.why_vote.turnout_snapshot": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turnout snapshot"
          }
        },
        "es": {
          "stringUnit": {
