{
  "sourceLanguage": "en",
  "strings": {
    "app.guide.card.general.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The general election determines who takes office from the candidates who qualified in earlier rounds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La elección general determina quién asume el cargo entre los candidatos que calificaron en rondas anteriores."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大选决定由此前轮次中胜出的候选人谁将就任公职。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinutukoy ng pangkalahatang halalan kung sino ang uupo sa posisyon mula sa mga kandidatong umabante sa naunang mga yugto."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bầu cử tổng tuyển cử quyết định ai sẽ nhậm chức trong số các ứng viên đã vượt qua các vòng trước."
          }
        }
      }
    },
    "app.guide.card.general.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "General Election"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elección general"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大选"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pangkalahatang Halalan"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tổng tuyển cử"
          }
        }
      }
    },
    "app.guide.card.jungle.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "California uses a top-two primary for many offices: all candidates appear on one ballot, and the top two finishers advance to the general election regardless of party."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "California usa una primaria top-two para muchos cargos: todos los candidatos aparecen en una sola boleta y los dos más votados avanzan a la elección general, sin importar el partido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加州在许多职位采用“前二名初选”：所有候选人同列一张选票，得票前两名不分党派进入大选。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa California, ginagamit sa maraming posisyon ang top-two primary: lahat ng kandidato ay nasa iisang balota at ang nangungunang dalawa ay umaabante sa pangkalahatang halalan anuman ang partido."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "California áp dụng sơ bộ top-two cho nhiều chức vụ: tất cả ứng viên cùng trên một lá phiếu và hai người dẫn đầu sẽ vào tổng tuyển cử bất kể đảng phái."
          }
        }
      }
    },
    "app.guide.card.jungle.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jungle Primary"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primaria abierta (top-two)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "丛林式初选"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Primary na Top-Two"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sơ bộ top-two"
          }
        }
      }
    },
    "app.guide.card.mayoral.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is on the ballot: mayor, and often city council or other city offices, plus local ballot questions depending on your city."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué aparece en la boleta: alcalde y, con frecuencia, concejo municipal u otros cargos de la ciudad, además de preguntas locales de boleta según tu ciudad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选票内容通常包括市长，以及市议会或其他市级职位，并可能有本地公投议题。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nilalaman ng balota: mayor, at madalas ay city council o iba pang posisyon sa lungsod, kasama ang lokal na mga tanong sa balota depende sa inyong lungsod."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung lá phiếu: thị trưởng, thường có hội đồng thành phố hoặc chức vụ thành phố khác, cùng các câu hỏi lá phiếu địa phương tùy thành phố."
          }
        }
      }
    },
    "app.guide.card.mayoral.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mayoral Elections"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elecciones de alcaldía"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "市长选举"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Halalan sa Alkalde"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bầu cử thị trưởng"
          }
        }
      }
    },
    "app.guide.card.midterm.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is on the ballot: all U.S. House seats, some U.S. Senate seats, many governor and state legislature races, and statewide/local ballot measures."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué aparece en la boleta: todos los escaños de la Cámara de Representantes de EE. UU., algunos del Senado, muchas contiendas para gobernador y legislaturas estatales, y medidas de boleta estatales/locales."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选票内容包括全部联邦众议院席位、部分联邦参议院席位、许多州长与州议会选举，以及州/地方公投。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nilalaman ng balota: lahat ng puwesto sa U.S. House, ilang puwesto sa U.S. Senate, maraming laban para sa gobernador at state legislature, at mga panrehiyon/lokal na panukala sa balota."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên lá phiếu có: toàn bộ ghế Hạ viện Hoa Kỳ, một số ghế Thượng viện Hoa Kỳ, nhiều cuộc đua thống đốc và nghị viện bang, cùng các sáng kiến toàn bang/địa phương."
          }
        }
      }
    },
    "app.guide.card.midterm.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Midterm Elections"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elecciones de mitad de período"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中期选举"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Halalang Midterm"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bầu cử giữa nhiệm kỳ"
          }
        }
      }
    },
    "app.guide.card.overview.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This guide is personalized to your next upcoming election based on your current ZIP and state."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta guía está personalizada para tu próxima elección según tu código postal y estado actuales."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本指南基于你当前的邮编和州，个性化显示你下一场即将到来的选举信息。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang gabay na ito ay naka-personalize para sa susunod mong halalan batay sa kasalukuyan mong ZIP at estado."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hướng dẫn này được cá nhân hóa cho kỳ bầu cử sắp tới của bạn dựa trên ZIP và bang hiện tại."
          }
        }
      }
    },
    "app.guide.card.overview.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Election Overview"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resumen electoral"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选举概览"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pangkalahatang-ideya ng Halalan"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tổng quan bầu cử"
          }
        }
      }
    },
    "app.guide.card.party_affiliation.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Democratic and Republican parties are the two largest in the United States. In many states, primary ballot eligibility depends on your current party registration. Example: in a closed primary, a voter registered as Independent may not be able to vote in either the Democratic or Republican primary unless they change party registration before the state deadline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La elegibilidad para la boleta primaria puede depender de tu afiliación partidaria actual. Confirma las reglas de tu estado antes del día de la elección."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "初选选票资格可能取决于你当前的政党登记。请在选举日前确认所在州规则。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaaring nakadepende sa kasalukuyan mong rehistro sa partido ang pagiging karapat-dapat sa primary ballot. Kumpirmahin ang mga tuntunin ng inyong estado bago ang araw ng halalan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều kiện nhận lá phiếu sơ bộ có thể phụ thuộc vào đăng ký đảng hiện tại của bạn. Hãy xác nhận quy định của bang trước ngày bầu cử."
          }
        }
      }
    },
    "app.guide.card.party_affiliation.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Party Affiliation"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Afiliación partidaria"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "政党归属"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaakibat na Partido"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết đảng phái"
          }
        }
      }
    },
    "app.guide.card.presidential.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is on the ballot: president/vice president, all U.S. House seats, some U.S. Senate seats, and state and local offices or ballot measures where scheduled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué aparece en la boleta: presidente/vicepresidente, todos los escaños de la Cámara de Representantes de EE. UU., algunos escaños del Senado y cargos estatales/locales o medidas de boleta según corresponda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选票内容包括总统/副总统、全部联邦众议院席位、部分联邦参议院席位，以及安排在同日的州和地方职位或公投议题。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nilalaman ng balota: presidente/bise presidente, lahat ng puwesto sa U.S. House, ilang puwesto sa U.S. Senate, at mga posisyong pang-estado at lokal o panukala sa balota kung naka-iskedyul."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên lá phiếu có: tổng thống/phó tổng thống, toàn bộ ghế Hạ viện Hoa Kỳ, một số ghế Thượng viện Hoa Kỳ, cùng các chức vụ bang/địa phương hoặc sáng kiến lá phiếu theo lịch."
          }
        }
      }
    },
    "app.guide.card.presidential.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presidential Elections"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elecciones presidenciales"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总统选举"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Halalang Pampanguluhan"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bầu cử tổng thống"
          }
        }
      }
    },
    "app.guide.card.primary.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A primary election decides which candidates advance to the general election. Rules can vary by party and office."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una elección primaria decide qué candidatos avanzan a la elección general. Las reglas pueden variar según el partido y el cargo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "初选决定哪些候选人进入大选。规则会因政党和职位而异。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinutukoy ng primary election kung aling mga kandidato ang aabante sa pangkalahatang halalan. Maaaring mag-iba ang mga patakaran ayon sa partido at posisyon."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bầu cử sơ bộ quyết định ứng viên nào sẽ vào tổng tuyển cử. Quy tắc có thể khác nhau theo đảng và chức vụ."
          }
        }
      }
    },
    "app.guide.card.primary.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Primary Election"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una elección primaria"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "初选"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Primary Election"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bầu cử sơ bộ"
          }
        }
      }
    },
    "app.guide.card.ranked_choice.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ranked-choice voting can apply in covered contests. You can rank candidates in order of preference where allowed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La votación por orden de preferencia puede aplicarse en contiendas cubiertas. Puedes clasificar a los candidatos por orden de preferencia donde esté permitido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在适用的选举中可使用排序选择投票。若规则允许，你可以按偏好为候选人排序。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa mga saklaw na laban, maaaring gamitin ang ranked-choice voting. Maaari mong i-rank ang mga kandidato ayon sa gusto kung pinapayagan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong các cuộc bầu cử áp dụng, có thể dùng bỏ phiếu xếp hạng. Bạn có thể xếp ứng viên theo thứ tự ưu tiên khi được phép."
          }
        }
      }
    },
    "app.guide.card.ranked_choice.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ranked Choice"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Votación por orden de preferencia"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排序选择投票"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Niraranggong Pagpili"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ phiếu xếp hạng"
          }
        }
      }
    },
    "app.guide.card.runoff.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A runoff election happens when no candidate reaches the required threshold in the first primary round."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una segunda vuelta ocurre cuando ningún candidato alcanza el umbral requerido en la primera ronda primaria."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若首轮初选中无人达到法定门槛，就会举行决选。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagaganap ang runoff election kapag walang kandidatong umabot sa kinakailangang threshold sa unang round ng primary."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bầu cử vòng hai diễn ra khi không ứng viên nào đạt ngưỡng yêu cầu ở vòng sơ bộ đầu tiên."
          }
        }
      }
    },
    "app.guide.card.runoff.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Primary Runoff"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Segunda vuelta primaria"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "初选决选"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Runoff sa Primary"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bầu cử vòng hai sơ bộ"
          }
        }
      }
    },
    "app.guide.card.special.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Special elections fill vacancies or decide urgent ballot questions outside the normal election calendar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las elecciones especiales cubren vacantes o deciden asuntos urgentes de la boleta fuera del calendario electoral normal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "特别选举用于填补空缺职位，或在常规选举日程之外决定紧急议题。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang special election ay para punan ang bakanteng puwesto o pagdesisyunan ang mahahalagang usapin sa balota sa labas ng regular na kalendaryo ng halalan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
