    "app.guide.voting.by_mail.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request and return your mail ballot by your state's deadlines."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicita y devuelve tu boleta por correo según los plazos de tu estado."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Humiling at ibalik ang iyong mail ballot ayon sa mga deadline ng iyong estado."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu và gửi lại phiếu bầu qua thư theo hạn chót của bang bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请按你所在州的截止日期申请并寄回邮寄选票。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "请按你所在州的截止日期申请并寄回邮寄选票。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Request and return your mail ballot by your state's deadlines."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Request and return your mail ballot by your state's deadlines."
          }
        }
      }
