    "app.registration.card.provisional.bullet_5.updated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A voter cannot provide the state's identification requirements immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un votante no puede presentar de inmediato los requisitos de identificación del estado."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi agad maibigay ng botante ang mga kinakailangang ID ng estado."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cử tri không thể cung cấp ngay yêu cầu giấy tờ nhận dạng của bang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选民无法立即提供州要求的身份证明。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "选民无法立即提供州要求的身份证明。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
