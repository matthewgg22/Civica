    "app.guide.office_influence.president": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: sets national executive priorities, federal agency direction, and veto/sign authority."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: fija prioridades del poder ejecutivo nacional, la dirección de agencias federales y la autoridad de veto/firma."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: nagtatakda ng pambansang prayoridad ng ehekutibo, direksyon ng mga pederal na ahensya, at kapangyarihang mag-veto/magpirma."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: đặt ưu tiên hành pháp quốc gia, định hướng cơ quan liên bang và quyền phủ quyết/ký ban hành."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：决定国家行政优先事项、联邦机构方向以及否决/签署权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：決定國家行政優先事項、聯邦機構方向以及否決／簽署權。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: définit les priorités exécutives nationales, l’orientation des agences fédérales et le pouvoir de veto/signature."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: setzt nationale Exekutivprioritäten, steuert Bundesbehörden und hat Vetorecht/Unterzeichnungsbefugnis."
          }
        }
      }
    },
    "app.guide.office_influence.senate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: shapes federal law, confirms judges/appointments, and approves treaties."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: moldea la ley federal, confirma jueces/nombramientos y aprueba tratados."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: humuhubog sa pederal na batas, nagkukumpirma ng mga hukom/hirang, at nag-aapruba ng mga tratado."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: định hình luật liên bang, phê chuẩn thẩm phán/bổ nhiệm và phê chuẩn hiệp ước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：塑造联邦法律，确认法官/任命，并批准条约。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：塑造聯邦法律，確認法官／任命，並批准條約。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: façonne la loi fédérale, confirme les juges/nominations et approuve les traités."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: gestaltet Bundesgesetze, bestätigt Richter/Ernennungen und ratifiziert Verträge."
          }
        }
      }
    },
    "app.guide.office_influence.house": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: initiates budget/tax bills and represents district interests in federal legislation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: inicia proyectos de presupuesto/impuestos y representa intereses del distrito en la legislación federal."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: nagsisimula ng mga panukalang badyet/buwis at kumakatawan sa interes ng distrito sa pederal na batas."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: khởi xướng dự luật ngân sách/thuế và đại diện lợi ích khu vực trong luật liên bang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：发起预算/税收法案，并在联邦立法中代表选区利益。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：發起預算／稅收法案，並在聯邦立法中代表選區利益。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: initie les textes budgétaires/fiscaux et représente les intérêts du district dans la législation fédérale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: bringt Haushalts-/Steuergesetze ein und vertritt Distriktinteressen in der Bundesgesetzgebung."
          }
        }
      }
    },
    "app.guide.office_influence.governor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: leads state executive branch, signs/vetoes state laws, and sets state policy direction."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: dirige el poder ejecutivo estatal, firma/veta leyes estatales y marca la dirección de políticas estatales."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: namumuno sa sangay ehekutibo ng estado, lumalagda/nagve-veto ng batas ng estado, at nagtatakda ng direksyon ng patakaran ng estado."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: lãnh đạo nhánh hành pháp bang, ký/phủ quyết luật bang và định hướng chính sách bang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：领导州行政部门，签署/否决州法律，并确定州政策方向。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：領導州行政部門，簽署／否決州法律，並確定州政策方向。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: dirige l’exécutif de l’État, signe/met son veto aux lois de l’État et fixe l’orientation des politiques de l’État."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: führt die Exekutive des Bundesstaats, unterzeichnet/vetoisiert Landesgesetze und setzt die politische Richtung."
          }
        }
      }
    },
    "app.guide.office_influence.state_legislature": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: passes state laws, budgets, and policy frameworks that affect statewide programs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: aprueba leyes estatales, presupuestos y marcos de política que afectan programas estatales."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: nagpapatibay ng batas ng estado, badyet, at mga balangkas ng patakaran na nakaaapekto sa mga programang pambuong-estado."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: thông qua luật bang, ngân sách và khung chính sách ảnh hưởng đến các chương trình toàn bang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：通过州法律、预算和政策框架，影响全州项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：通過州法律、預算和政策框架，影響全州項目。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: adopte des lois de l’État, des budgets et des cadres politiques qui affectent les programmes à l’échelle de l’État."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: verabschiedet Landesgesetze, Haushalte und Politikrahmen, die landesweite Programme beeinflussen."
          }
        }
      }
    },
    "app.guide.office_influence.judicial": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: interprets laws and legal disputes, affecting rights and policy application."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: interpreta leyes y disputas legales, afectando derechos y aplicación de políticas."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: nagbibigay-kahulugan sa batas at mga legal na alitan, na nakaaapekto sa mga karapatan at pagpapatupad ng patakaran."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: diễn giải luật và tranh chấp pháp lý, ảnh hưởng đến quyền và việc áp dụng chính sách."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：解释法律和法律争议，影响权利与政策执行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：解釋法律和法律爭議，影響權利與政策執行。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: interprète les lois et les litiges juridiques, ce qui affecte les droits et l’application des politiques."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: legt Gesetze und Rechtsstreitigkeiten aus und beeinflusst dadurch Rechte und die Umsetzung von Politik."
          }
        }
      }
    },
    "app.guide.office_influence.local": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: impacts city/county budgets, schools, zoning, transportation, and public safety decisions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: impacta presupuestos de ciudad/condado, escuelas, zonificación, transporte y decisiones de seguridad pública."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: nakaaapekto sa badyet ng lungsod/county, mga paaralan, zoning, transportasyon, at mga desisyon sa pampublikong kaligtasan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: ảnh hưởng ngân sách thành phố/hạt, trường học, quy hoạch, giao thông và quyết định an toàn công cộng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：影响市/县预算、学校、分区、交通和公共安全决策。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：影響市／縣預算、學校、分區、交通和公共安全決策。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: influence les budgets de ville/comté, les écoles, le zonage, les transports et les décisions de sécurité publique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: beeinflusst Stadt-/County-Haushalte, Schulen, Zonierung, Verkehr und Entscheidungen zur öffentlichen Sicherheit."
          }
        }
      }
    },
    "app.guide.office_influence.ballot_measures": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: allows direct voter decisions on policy, funding, or constitutional/statutory changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: permite decisiones directas de votantes sobre políticas, financiamiento o cambios constitucionales/legales."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: nagbibigay-daan sa direktang desisyon ng botante sa patakaran, pondo, o mga pagbabagong konstitusyonal/batas."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: cho phép cử tri quyết định trực tiếp về chính sách, ngân sách hoặc thay đổi hiến pháp/pháp luật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：让选民可直接决定政策、资金或宪法/法律变更。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：讓選民可直接決定政策、資金或憲法／法律變更。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: permet des décisions directes des électeurs sur les politiques, le financement ou des changements constitutionnels/législatifs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: ermöglicht direkte Wählerentscheidungen zu Politik, Finanzierung oder verfassungs-/gesetzlichen Änderungen."
          }
        }
      }
    },
    "app.guide.office_influence.generic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: affects policy and governance outcomes for your community and representation level."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: afecta resultados de políticas y gobernanza para tu comunidad y nivel de representación."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: nakaaapekto sa mga kinalabasan ng patakaran at pamamahala para sa iyong komunidad at antas ng representasyon."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: ảnh hưởng kết quả chính sách và quản trị cho cộng đồng và cấp đại diện của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：会影响你所在社区及代表层级的政策与治理结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：會影響你所在社區及代表層級的政策與治理結果。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: affecte les résultats des politiques et de la gouvernance pour votre communauté et votre niveau de représentation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: beeinflusst Politik- und Governance-Ergebnisse für Ihre Gemeinde und Vertretungsebene."
          }
        }
      }
    },
