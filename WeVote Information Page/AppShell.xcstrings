          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bang của bạn có thể đặt hạn khác nhau cho hình thức trực tuyến, qua thư và trực tiếp."
          }
        },
        "zh-Hant": {
