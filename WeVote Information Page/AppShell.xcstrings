    "app.registration.card.deadline.bullet_1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your state can set different cutoffs for online, mail, and in-person methods."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu estado puede tener fechas límite diferentes para métodos en línea, por correo y en persona."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的州可能为在线、邮寄和现场方式设置不同的截止时间。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaaring magkaiba ang cutoff ng iyong estado para sa online, koreo, at in-person na pamamaraan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bang của bạn có thể đặt hạn khác nhau cho hình thức trực tuyến, qua thư và trực tiếp."
          }
        }
      }
    },
    "app.registration.card.deadline.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deadlines vary by state and method. Register early so you have time to fix any issues before polls open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fechas límite varían según el estado y el método. Regístrate temprano para tener tiempo de corregir cualquier problema antes de que abran las urnas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各州和登记方式的截止日期不同。请尽早登记，以便在投票开始前有时间处理问题。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagkakaiba ang deadline ayon sa estado at paraan. Magparehistro nang maaga para may oras kang ayusin ang anumang isyu bago bumukas ang botohan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hạn chót khác nhau theo bang và phương thức. Hãy đăng ký sớm để có thời gian xử lý vấn đề trước khi mở điểm bỏ phiếu."
          }
        }
      }
    },
    "app.registration.card.deadline.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Register before the deadline"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Regístrate antes de la fecha límite"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在截止日期前完成登记"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magparehistro bago ang deadline"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng ký trước hạn chót"
          }
        }
      }
    },
    "app.registration.card.then_vote.bullet_1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make a plan for when and where you will vote."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz un plan para cuándo y dónde vas a votar."
          }
