            "value": "Ano ang mail-in voting?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ phiếu qua thư là gì?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "什么是邮寄投票？"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "What is mail-in voting?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "What is mail-in voting?"
          }
        }
      }
    },
    "app.mapv.absentee.what_mail_in.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail-in voting lets eligible voters receive a ballot and return it by mail or approved drop-off methods. Some states mail ballots automatically, while others require a request."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La votación por correo permite que las personas elegibles reciban una boleta y la devuelvan por correo o mediante métodos de entrega autorizados. Algunos estados envían boletas automáticamente y otros requieren una solicitud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邮寄投票允许符合资格的选民收到选票，并通过邮寄或指定投递方式寄回。有些州会自动寄送选票，另一些州则需要申请。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinapayagan ng mail-in voting ang karapat-dapat na botante na makatanggap ng balota at ibalik ito sa koreo o aprubadong drop-off. May mga estadong awtomatikong nagpapadala ng balota, at may ibang nangangailangan ng request."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ phiếu qua thư cho phép cử tri đủ điều kiện nhận phiếu và gửi lại qua thư hoặc điểm nộp được chấp thuận. Một số bang gửi phiếu tự động, số khác yêu cầu nộp đơn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "邮寄投票允许符合资格的选民收到选票，并通过邮寄或指定投递方式寄回。有些州会自动寄送选票，另一些州则需要申请。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail-in voting lets eligible voters receive a ballot and return it by mail or approved drop-off methods. Some states mail ballots automatically, while others require a request."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail-in voting lets eligible voters receive a ballot and return it by mail or approved drop-off methods. Some states mail ballots automatically, while others require a request."
          }
        }
      }
    },
    "app.mapv.absentee.what_absentee.title": {
      "extractionState": "manual",
      "localizations": {
