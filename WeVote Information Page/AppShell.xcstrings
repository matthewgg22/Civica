    "app.timeline.ballot.state_legislature.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "District-based State Senate and State House/Assembly races when scheduled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contiendas por distrito para Senado estatal y Cámara/Asamblea estatal cuando estén programadas."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga distritong laban para sa State Senate at State House/Assembly kapag naka-iskedyul."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các cuộc đua theo khu vực cho Thượng viện bang và Hạ viện/Hội đồng bang khi có lịch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按选区进行的州参议院和州众议院/州议会选举（如有安排）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按選區進行的州參議院和州眾議院／州議會選舉（如有安排）。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Courses de circonscription pour le Sénat de l’État et la Chambre/Assemblée de l’État lorsqu’elles sont prévues."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wahlkreisbasierten Rennen für den Landessenat und das Staatshaus/die Landesversammlung, sofern angesetzt."
          }
        }
      }
    },
