    "app.why_vote.takeaway.full": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In %@, about %@ voted in the last presidential election, but only %@ voted in the last midterm. That means many eligible voters sat out, even though close races can be decided by tiny margins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En %@, aproximadamente %@ votó en la última elección presidencial, pero solo %@ votó en la última elección de mitad de período. Eso significa que muchos votantes elegibles no participaron, aunque las contiendas cerradas pueden decidirse por márgenes mínimos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %@，最近一次总统选举的投票率约为 %@，但最近一次中期选举只有 %@。这意味着很多合格选民没有投票，而胶着选举往往由微小差距决定。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa %@, humigit-kumulang %@ ang bumoto sa huling presidential election, pero %@ lang sa huling midterm. Ibig sabihin, maraming kwalipikadong botante ang hindi nakaboto, kahit na maliliit na agwat lang ang puwedeng magpasya sa dikit na laban."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tại %@, khoảng %@ đã đi bầu trong kỳ tổng thống gần nhất, nhưng chỉ %@ trong kỳ giữa nhiệm kỳ gần nhất. Điều đó nghĩa là nhiều cử tri đủ điều kiện đã không đi bầu, dù các cuộc đua sít sao có thể được quyết định bởi chênh lệch rất nhỏ."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %@，最近一次总统选举的投票率约为 %@，但最近一次中期选举只有 %@。这意味着很多合格选民没有投票，而胶着选举往往由微小差距决定。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "In %@, about %@ voted in the last presidential election, but only %@ voted in the last midterm. That means many eligible voters sat out, even though close races can be decided by tiny margins."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In %@, about %@ voted in the last presidential election, but only %@ voted in the last midterm. That means many eligible voters sat out, even though close races can be decided by tiny margins."
          }
        }
      }
    },
    "app.why_vote.takeaway.limited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In %@, some turnout fields are not available in this summary. Even with incomplete data, close-race history shows that small vote shifts can change results."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En %@, algunos campos de participación no están disponibles en este resumen. Incluso con datos incompletos, el historial de contiendas cerradas muestra que pequeños cambios de voto pueden cambiar resultados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %@，本摘要中的部分投票率字段暂不可用。即使数据不完整，胶着选举历史仍表明小幅投票变化会改变结果。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa %@, may ilang turnout fields na hindi available sa buod na ito. Kahit kulang ang datos, ipinapakita ng history ng close races na puwedeng magbago ang resulta sa maliliit na pagbabago sa boto."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tại %@, một số trường dữ liệu turnout chưa có trong phần tóm tắt này. Dù dữ liệu chưa đầy đủ, lịch sử các cuộc đua sít sao cho thấy thay đổi nhỏ về phiếu bầu có thể đổi kết quả."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %@，本摘要中的部分投票率字段暂不可用。即使数据不完整，胶着选举历史仍表明小幅投票变化会改变结果。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "In %@, some turnout fields are not available in this summary. Even with incomplete data, close-race history shows that small vote shifts can change results."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In %@, some turnout fields are not available in this summary. Even with incomplete data, close-race history shows that small vote shifts can change results."
          }
        }
      }
    },
