    "app.registration.card.what_is.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voter registration is the process that puts you on your state’s voter rolls so you are eligible to vote."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro de votantes es el proceso que te incluye en el padrón de tu estado para que puedas votar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选民登记是将你加入本州选民名册、使你具备投票资格的流程。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang voter registration ang prosesong naglalagay sa iyo sa listahan ng mga botante ng estado upang maging karapat-dapat kang bumoto."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng ký cử tri là quy trình đưa bạn vào danh sách cử tri của bang để đủ điều kiện bỏ phiếu."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "选民登记是将你加入本州选民名册、使你具备投票资格的流程。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voter registration is the process that puts you on your state’s voter rolls so you are eligible to vote."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Voter registration is the process that puts you on your state’s voter rolls so you are eligible to vote."
          }
        }
      }
    },
