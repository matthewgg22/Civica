    "app.guide.card.primary.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A primary election decides which candidates advance to the general election. Rules can vary by party and office."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una elección primaria decide qué candidatos avanzan a la elección general. Las reglas pueden variar según el partido y el cargo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "初选决定哪些候选人进入大选。规则会因政党和职位而异。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinutukoy ng primary election kung aling mga kandidato ang aabante sa pangkalahatang halalan. Maaaring mag-iba ang mga patakaran ayon sa partido at posisyon."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bầu cử sơ bộ quyết định ứng viên nào sẽ vào tổng tuyển cử. Quy tắc có thể khác nhau theo đảng và chức vụ."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "初选决定哪些候选人进入大选。规则会因政党和职位而异。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "A primary election decides which candidates advance to the general election. Rules can vary by party and office."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "A primary election decides which candidates advance to the general election. Rules can vary by party and office."
          }
        }
      }
    },
