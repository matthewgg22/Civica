    "app.why_vote.why_care.card1.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When turnout is lower, each vote carries more weight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando la participación es menor, cada voto pesa más."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag mas mababa ang turnout, mas mabigat ang bawat boto."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi turnout thấp hơn, mỗi lá phiếu có trọng lượng lớn hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
