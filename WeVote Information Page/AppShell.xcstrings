        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitado pa ang turnout data sa ngayon. Magpapakita kami ng direktang paghahambing kapag may magkatugmang statewide presidential at midterm values na."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu turnout hiện còn hạn chế. Chúng tôi sẽ hiển thị so sánh trực tiếp ngay khi có các giá trị statewide presidential và midterm khớp nhau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前投票率数据有限。只要有匹配的全州presidential与midterm数据，我们就会显示直接对比。"
          }
