    "app.election_hotlines.general.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Have questions about how, when, or where to vote? Contact this hotline to get clear info from trained professionals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Tienes preguntas sobre cómo, cuándo o dónde votar? Contacta esta línea para obtener información clara de profesionales capacitados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对何时、何地、如何投票有疑问吗？请联系该热线，获取专业人员提供的清晰信息。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May tanong ka tungkol sa paano, kailan, o saan boboto? Kontakin ang hotline na ito para sa malinaw na impormasyon mula sa mga bihasang propesyonal."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có câu hỏi về cách, thời điểm hoặc nơi bỏ phiếu? Hãy liên hệ đường dây nóng này để nhận thông tin rõ ràng từ đội ngũ chuyên trách."
          }
        }
      }
    },
    "app.election_hotlines.intimidation.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "🚨 Report Voter Intimidation"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "🚨 Reportar intimidación a votantes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "🚨 举报选民恐吓"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "🚨 Iulat ang Pananakot sa Botante"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "🚨 Báo cáo đe dọa cử tri"
          }
        }
      }
    },
    "app.election_hotlines.intimidation.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you or someone you know is being threatened or blocked from voting, call this national hotline immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tú o alguien que conoces está siendo amenazado o bloqueado para votar, llama de inmediato a esta línea nacional."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你或你认识的人在投票时受到威胁或阻碍，请立即拨打这条全国热线。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung ikaw o may kilala kang tinatakot o hinahadlangang bumoto, tawagan agad ang pambansang hotline na ito."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn hoặc người quen của bạn bị đe dọa hoặc cản trở việc bỏ phiếu, hãy gọi ngay đường dây nóng quốc gia này."
          }
        }
      }
    }
  },
  "version": "1.0"
}
