    "app.mapv.absentee.fallback.jurisdiction_missing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We could not detect your jurisdiction yet. Enter your address in My Reps to auto-load absentee and mail-ballot request details."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no pudimos detectar tu jurisdicción. Ingresa tu dirección en Mis reps para cargar automáticamente los detalles de solicitud de voto en ausencia y por correo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂未识别你的辖区。请在 My Reps 中输入地址，以自动加载缺席/邮寄选票申请信息。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pa namin matukoy ang iyong hurisdiksyon. Ilagay ang iyong address sa My Reps para awtomatikong ma-load ang detalye ng absentee at mail-ballot request."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi chưa xác định được khu vực thẩm quyền của bạn. Hãy nhập địa chỉ trong My Reps để tự động tải thông tin yêu cầu phiếu vắng mặt/qua thư."
          }
        }
      }
    },
