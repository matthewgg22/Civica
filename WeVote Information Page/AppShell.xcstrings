    "app.feedback.college_endeavor.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VoteNow is an endeavor built to support all Americans vote by reducing logistical friction. As a college student endeavor, we want to learn from you and your experience voting. Your feedback is invaluable to improve the app and the voter experience."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "VoteNow es un proyecto universitario creado para apoyar a todas las personas en EE. UU. reduciendo la fricción logística al votar. Nos encantaría recibir tus comentarios para mejorar la app y la experiencia general de votación."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VoteNow 是由大学生发起的项目，旨在通过减少投票流程中的后勤摩擦，远程支持所有美国人。我们非常希望收到你的反馈，以改进应用和整体投票体验。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang VoteNow ay proyektong pinangungunahan ng mga estudyante sa kolehiyo upang suportahan ang lahat ng Amerikano sa pamamagitan ng pagbawas ng abalang proseso sa pagboto. Gusto naming marinig ang iyong feedback para mapabuti ang app at kabuuang karanasan ng botante."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "VoteNow là một dự án do sinh viên đại học xây dựng nhằm hỗ trợ mọi người Mỹ từ xa bằng cách giảm bớt rào cản hậu cần trong việc bỏ phiếu. Chúng tôi rất mong nhận được phản hồi của bạn để cải thiện ứng dụng và trải nghiệm cử tri tổng thể."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "VoteNow 是由大学生发起的项目，旨在通过减少投票流程中的后勤摩擦，远程支持所有美国人。我们非常希望收到你的反馈，以改进应用和整体投票体验。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "VoteNow is an endeavor built to support all Americans vote by reducing logistical friction. As a college student endeavor, we want to learn from you and your experience voting. Your feedback is invaluable to improve the app and the voter experience."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VoteNow is an endeavor built to support all Americans vote by reducing logistical friction. As a college student endeavor, we want to learn from you and your experience voting. Your feedback is invaluable to improve the app and the voter experience."
          }
        }
      }
    },
