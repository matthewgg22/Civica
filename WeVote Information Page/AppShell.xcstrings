    "app.sample_ballot.ranked_choice.body_1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This sample is structured for ranked-choice voting, so you can set your candidate order now before entering the voting booth."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta muestra está estructurada para voto por orden de preferencia, para que puedas definir el orden de tus candidatos antes de votar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该样本采用排序选择投票结构，你可以在进入投票站前先设置候选人顺序。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang sample na ito ay para sa ranked-choice voting para maayos mo na ang pagkakasunod ng kandidato bago pumasok sa botohan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mẫu này được thiết kế cho bỏ phiếu xếp hạng, để bạn có thể sắp thứ tự ứng viên trước khi vào điểm bỏ phiếu."
          }
        }
      }
    },
    "app.sample_ballot.ranked_choice.body_2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only candidates matching your selected party registration are shown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se muestran candidatos que coinciden con el partido que seleccionaste."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅显示与你所选政党登记匹配的候选人。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipinapakita lamang ang mga kandidatong tumutugma sa napili mong party registration."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ hiển thị các ứng viên phù hợp với đăng ký đảng bạn đã chọn."
          }
        }
      }
    },
    "app.sample_ballot.empty.no_match": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No candidates match your selected party registration in this sample."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún candidato coincide con el partido seleccionado en esta muestra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此样本中没有与你当前政党登记匹配的候选人。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang kandidatong tumutugma sa napili mong party registration sa sample na ito."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có ứng viên nào khớp với đăng ký đảng đã chọn của bạn trong mẫu này."
          }
        }
      }
    },
