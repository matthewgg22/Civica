    "app.timeline.ballot.runoff_intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runoff elections are held when no candidate reaches the required threshold in the primary."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las elecciones runoff se realizan cuando ningún candidato alcanza el umbral requerido en la primary."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang runoff elections ay ginaganap kapag walang kandidatong umabot sa kinakailangang threshold sa primary."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bầu cử runoff được tổ chức khi không ứng viên nào đạt ngưỡng yêu cầu trong primary."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当没有候选人在primary中达到规定门槛时，将举行runoff选举。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "当没有候选人在primary中达到规定门槛时，将举行runoff选举。"
          }
        },
