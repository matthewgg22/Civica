      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "🗳️ General Voter Hotline"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "🗳️ Línea general para votantes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "🗳️ 普通选民热线"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
