    "app.support_vote.supports.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As a college-founded civic startup, we rely on community support to keep voter tools accessible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como startup cívica fundada en la universidad, dependemos del apoyo de la comunidad para mantener accesibles las herramientas para votantes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "作为大学创立的公民科技项目，我们依靠社区支持来保持投票工具可及。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilang civic startup na itinatag ng mga estudyante, umaasa kami sa suporta ng komunidad para manatiling accessible ang mga voter tools."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Là một startup công dân do sinh viên sáng lập, chúng tôi dựa vào sự hỗ trợ cộng đồng để giữ các công cụ cử tri luôn dễ tiếp cận."
          }
        }
      }
    },
