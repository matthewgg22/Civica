    "app.why_vote.fact.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Midterm turnout is lower, around 50-53% nationally."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La participación en elecciones intermedias suele ser más baja, alrededor del 50-53% a nivel nacional."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中期选举投票率更低，全国约 50–53%。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mas mababa ang turnout sa midterm, humigit-kumulang 50-53% sa bansa."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tỷ lệ đi bầu giữa nhiệm kỳ thấp hơn, khoảng 50-53% trên toàn quốc."
          }
        }
      }
    },
    "app.why_vote.fact.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close elections are common, so small turnout shifts can change statewide outcomes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las elecciones cerradas son comunes, así que pequeños cambios en participación pueden cambiar resultados estatales."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "势均力敌的选举很常见，因此小幅投票率变化也会改变全州结果。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Karaniwan ang dikit na halalan, kaya ang maliit na pagbabago sa turnout ay puwedeng magbago ng statewide na resulta."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các cuộc bầu cử sít sao rất phổ biến, nên thay đổi nhỏ về tỷ lệ đi bầu có thể đổi kết quả toàn bang."
          }
        }
      }
    },
    "app.why_vote.fact.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In recent presidential elections, U.S. turnout has been around 61-67%."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En elecciones presidenciales recientes, la participación en EE. UU. ha estado alrededor del 61-67%."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在最近的总统选举中，美国投票率约为 61–67%。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa mga kamakailang presidential elections, nasa 61-67% ang turnout sa U.S."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong các kỳ bầu cử tổng thống gần đây, tỷ lệ đi bầu ở Mỹ khoảng 61-67%."
          }
        }
      }
    },
