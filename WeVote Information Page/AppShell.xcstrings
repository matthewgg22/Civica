    "app.guide.card.offices_influence.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This card frames what each office generally controls."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tarjeta muestra lo que generalmente controla cada cargo. Se muestra texto provisional hasta que se integre tu conjunto completo de datos de influencia por cargo."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipinapakita ng card na ito kung ano ang karaniwang saklaw ng bawat opisina. Pansamantalang teksto muna ang makikita hanggang ma-integrate ang kumpletong office-influence dataset mo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thẻ này mô tả những gì mỗi chức vụ thường kiểm soát. Văn bản tạm thời sẽ hiển thị cho đến khi bộ dữ liệu ảnh hưởng theo chức vụ được tích hợp đầy đủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此卡片说明各职位通常负责的内容。在完整职位影响数据集整合前，会显示占位文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此卡片说明各职位通常负责的内容。在完整职位影响数据集整合前，会显示占位文本。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "This card frames what each office generally controls."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "This card frames what each office generally controls."
          }
        }
      }
    },
