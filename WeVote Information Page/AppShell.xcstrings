    "app.why_vote.why_care.card2.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "State and local leaders shape housing, schools, transit, taxes, and public services."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Líderes estatales y locales definen vivienda, escuelas, transporte, impuestos y servicios públicos."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinuhubog ng mga pinuno ng estado at lokal ang pabahay, paaralan, transportasyon, buwis, at pampublikong serbisyo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lãnh đạo bang và địa phương định hình nhà ở, trường học, giao thông, thuế và dịch vụ công."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "州和地方领导者会影响住房、学校、交通、税收和公共服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "州和地方领导者会影响住房、学校、交通、税收和公共服务。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "State and local leaders shape housing, schools, transit, taxes, and public services."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "State and local leaders shape housing, schools, transit, taxes, and public services."
          }
        }
      }
    },
    "app.why_vote.why_care.card3.title": {
      "extractionState": "manual",
      "localizations": {
