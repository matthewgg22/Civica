    "app.why_vote.why_care.card3.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A smaller group ends up deciding who represents your community."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un grupo más pequeño termina decidiendo quién representa a tu comunidad."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mas maliit na grupo ang nauuwi sa pagdedesisyon kung sino ang kakatawan sa komunidad mo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một nhóm nhỏ hơn sẽ quyết định ai đại diện cho cộng đồng của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最终由更小的一群人决定谁代表你的社区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最终由更小的一群人决定谁代表你的社区。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "A smaller group ends up deciding who represents your community."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "A smaller group ends up deciding who represents your community."
          }
        }
      }
    },
