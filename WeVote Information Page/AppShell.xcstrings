    "app.guide.card.top_two.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Washington uses a top-two style primary for many races, where all voters can choose from all candidates and the top two advance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Washington usa una primaria de estilo top-two en muchas contiendas, donde todos los votantes pueden elegir entre todos los candidatos y los dos más votados avanzan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "华盛顿州在许多选举采用“前二名初选”，所有选民可在全部候选人中选择，前两名进入大选。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa Washington, gumagamit ng top-two style primary sa maraming laban kung saan lahat ng botante ay maaaring pumili mula sa lahat ng kandidato at ang nangungunang dalawa ay umaabante."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Washington dùng mô hình sơ bộ top-two cho nhiều cuộc đua, nơi mọi cử tri đều có thể chọn trong tất cả ứng viên và hai người dẫn đầu sẽ đi tiếp."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "华盛顿州在许多选举采用“前二名初选”，所有选民可在全部候选人中选择，前两名进入大选。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Washington uses a top-two style primary for many races, where all voters can choose from all candidates and the top two advance."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Washington uses a top-two style primary for many races, where all voters can choose from all candidates and the top two advance."
          }
        }
      }
    },
