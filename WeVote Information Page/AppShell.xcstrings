    "app.guide.card.ballot_measures.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ballot measures are policy questions voters decide directly. They can change laws, funding, or state constitutions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las medidas en la boleta son preguntas de política que los votantes deciden directamente. Pueden cambiar leyes, financiamiento o constituciones estatales."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang ballot measures ay mga tanong sa polisiya na direktang pinapasyahan ng mga botante. Maaari nitong baguhin ang mga batas, pondo, o mga konstitusyon ng estado."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các ballot measure là các câu hỏi chính sách do cử tri quyết định trực tiếp. Chúng có thể thay đổi luật, nguồn tài trợ hoặc hiến pháp bang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选票措施是由选民直接决定的政策问题。它们可以改变法律、资金或州宪法。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "选票措施是由选民直接决定的政策问题。它们可以改变法律、资金或州宪法。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ballot measures are policy questions voters decide directly. They can change laws, funding, or state constitutions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ballot measures are policy questions voters decide directly. They can change laws, funding, or state constitutions."
          }
        }
      }
    },
