          }
        }
      }
    },
    "app.sample_ballot.ranked_choice.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ranked-Choice Prep"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparación para voto por orden de preferencia"
          }
