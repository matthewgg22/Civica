    "app.gov_help.opening.no_zip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can help route your government issue to the right office. Casework is usually handled only for constituents, so please confirm the ZIP used to load your representatives."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedo ayudarte a dirigir tu problema gubernamental a la oficina correcta. Los casos normalmente solo se atienden para constituyentes, así que confirma el código postal usado para cargar tus representantes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我可以帮助你将政府问题转到正确部门。议员办公室通常只处理其选民事务，因此请确认用于加载代表信息的 ZIP 代码。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Matutulungan kitang i-route ang iyong isyu sa tamang opisina. Kadalasang para lang sa constituents ang casework, kaya pakikumpirma ang ZIP na ginamit sa pag-load ng iyong mga kinatawan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi có thể giúp chuyển vấn đề của bạn đến đúng cơ quan. Hồ sơ vụ việc thường chỉ được xử lý cho cư dân trong khu vực, vì vậy vui lòng xác nhận mã ZIP đã dùng để tải đại diện của bạn."
          }
        }
      }
    },
    "app.gov_help.opening.with_zip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can help route your government issue to the right office. Casework is usually handled only for constituents, so please confirm you want to use ZIP %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedo ayudarte a dirigir tu problema gubernamental a la oficina correcta. Los casos normalmente solo se atienden para constituyentes, así que confirma que quieres usar el código postal %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我可以帮助你把政府问题转到正确部门。议员办公室通常只处理其选民事务，所以请确认你要使用 ZIP %@。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Matutulungan kitang i-route ang iyong isyu sa tamang opisina. Kadalasang para lang sa constituents ang casework, kaya pakikumpirma na gusto mong gamitin ang ZIP %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi có thể giúp chuyển vấn đề của bạn đến đúng cơ quan. Hồ sơ vụ việc thường chỉ xử lý cho cư dân trong khu vực, vì vậy vui lòng xác nhận bạn muốn dùng ZIP %@."
          }
        }
      }
    },
