    "app.support_vote.mission.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empower Americans Vote!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Impulsa el voto en EE. UU.!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "赋能美国选民！"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bigyang-lakas ang mga Amerikanong Botante!"
          }
        },
        "vi": {
