{
  "sourceLanguage": "en",
  "strings": {
    "app.guide.card.general.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The general election determines who takes office from the candidates who qualified in earlier rounds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La elección general determina quién asume el cargo entre los candidatos que calificaron en rondas anteriores."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大选决定由此前轮次中胜出的候选人谁将就任公职。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinutukoy ng pangkalahatang halalan kung sino ang uupo sa posisyon mula sa mga kandidatong umabante sa naunang mga yugto."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bầu cử tổng tuyển cử quyết định ai sẽ nhậm chức trong số các ứng viên đã vượt qua các vòng trước."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大选决定由此前轮次中胜出的候选人谁将就任公职。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "The general election determines who takes office from the candidates who qualified in earlier rounds."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "The general election determines who takes office from the candidates who qualified in earlier rounds."
          }
        }
      }
    },
