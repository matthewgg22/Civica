    "app.registration.card.deadline.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deadlines vary by state and method. Register early so you have time to fix any issues before polls open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fechas límite varían según el estado y el método. Regístrate temprano para tener tiempo de corregir cualquier problema antes de que abran las urnas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各州和登记方式的截止日期不同。请尽早登记，以便在投票开始前有时间处理问题。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagkakaiba ang deadline ayon sa estado at paraan. Magparehistro nang maaga para may oras kang ayusin ang anumang isyu bago bumukas ang botohan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hạn chót khác nhau theo bang và phương thức. Hãy đăng ký sớm để có thời gian xử lý vấn đề trước khi mở điểm bỏ phiếu."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "各州和登记方式的截止日期不同。请尽早登记，以便在投票开始前有时间处理问题。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deadlines vary by state and method. Register early so you have time to fix any issues before polls open."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deadlines vary by state and method. Register early so you have time to fix any issues before polls open."
          }
        }
      }
    },
