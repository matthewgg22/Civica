    "app.guide.card.presidential.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is on the ballot: president/vice president, all U.S. House seats, some U.S. Senate seats, and state and local offices or ballot measures where scheduled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué aparece en la boleta: presidente/vicepresidente, todos los escaños de la Cámara de Representantes de EE. UU., algunos escaños del Senado y cargos estatales/locales o medidas de boleta según corresponda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选票内容包括总统/副总统、全部联邦众议院席位、部分联邦参议院席位，以及安排在同日的州和地方职位或公投议题。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nilalaman ng balota: presidente/bise presidente, lahat ng puwesto sa U.S. House, ilang puwesto sa U.S. Senate, at mga posisyong pang-estado at lokal o panukala sa balota kung naka-iskedyul."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên lá phiếu có: tổng thống/phó tổng thống, toàn bộ ghế Hạ viện Hoa Kỳ, một số ghế Thượng viện Hoa Kỳ, cùng các chức vụ bang/địa phương hoặc sáng kiến lá phiếu theo lịch."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "选票内容包括总统/副总统、全部联邦众议院席位、部分联邦参议院席位，以及安排在同日的州和地方职位或公投议题。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "What is on the ballot: president/vice president, all U.S. House seats, some U.S. Senate seats, and state and local offices or ballot measures where scheduled."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "What is on the ballot: president/vice president, all U.S. House seats, some U.S. Senate seats, and state and local offices or ballot measures where scheduled."
          }
        }
      }
    },
