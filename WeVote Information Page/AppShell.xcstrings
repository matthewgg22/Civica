    "app.guide.card.party_affiliation.suffix": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " parties are the two largest in the U.S. In many states, your registration determines which primary ballot you can use."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " partidos son los dos más grandes en EE. UU. En muchos estados, tu registro determina qué boleta de primary puedes usar."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": " na partido ang dalawang pinakamalaki sa U.S. Sa maraming estado, ang iyong rehistrasyon ang tumutukoy kung aling primary ballot ang puwede mong gamitin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": " là hai đảng lớn nhất ở Hoa Kỳ. Ở nhiều bang, thông tin đăng ký của bạn quyết định bạn có thể dùng loại phiếu primary nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是美国最大的两个政党。在许多州，你的登记信息决定你可以使用哪种primary选票。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "是美国最大的两个政党。在许多州，你的登记信息决定你可以使用哪种primary选票。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " parties are the two largest in the U.S. In many states, your registration determines which primary ballot you can use."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " parties are the two largest in the U.S. In many states, your registration determines which primary ballot you can use."
          }
        }
      }
    },
