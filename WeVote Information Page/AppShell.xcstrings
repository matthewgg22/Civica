    "app.registration.card.provisional.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request a provisional ballot if issues arise at the polling site"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicita una provisional ballot si surgen problemas en el lugar de votación"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Humiling ng provisional ballot kung may lumitaw na isyu sa polling site"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu provisional ballot nếu phát sinh vấn đề tại điểm bỏ phiếu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果在投票点出现问题，请申请provisional ballot"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果在投票点出现问题，请申请provisional ballot"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Request a provisional ballot if issues arise at the polling site"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Request a provisional ballot if issues arise at the polling site"
          }
        }
      }
    },
    "app.registration.card.provisional.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A provisional ballot is a ballot that’s set aside at the polls and reviewed later to determine if it can be counted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una provisional ballot es una boleta que se aparta en las urnas y se revisa después para decidir si puede contarse."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang provisional ballot ay balotang itinatabi sa presinto at sinusuri sa huli para malaman kung mabibilang ito."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Provisional ballot là lá phiếu được tách riêng tại điểm bỏ phiếu và xem xét sau để xác định có được tính hay không."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "provisional ballot是在投票站被单独保留并事后审核是否可计票的选票。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "provisional ballot是在投票站被单独保留并事后审核是否可计票的选票。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "A provisional ballot is a ballot that’s set aside at the polls and reviewed later to determine if it can be counted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "A provisional ballot is a ballot that’s set aside at the polls and reviewed later to determine if it can be counted."
          }
        }
      }
    },
    "app.registration.card.provisional.bullet_3.updated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If complications arise, states must offer a provisional ballot upon request to address:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pueden surgir complicaciones; por eso cada estado debe ofrecer una provisional ballot si se solicita. Puede ayudar a resolver:"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May mga komplikasyong maaaring mangyari, kaya bawat estado ay kailangang mag-alok ng provisional ballot kapag hiniling; makakatulong ito sa pagresolba ng:"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể phát sinh vấn đề, vì vậy mọi bang đều phải cung cấp provisional ballot khi được yêu cầu; nó có thể giúp giải quyết:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能会出现复杂情况，因此各州在被要求时都必须提供provisional ballot；这可以帮助解决："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可能会出现复杂情况，因此各州在被要求时都必须提供provisional ballot；这可以帮助解决："
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "If complications arise, states must offer a provisional ballot upon request to address:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "If complications arise, states must offer a provisional ballot upon request to address:"
          }
        }
      }
    },
    "app.registration.card.provisional.bullet_4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A voter claims they are registered but their name does not appear on the voter roll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un votante afirma estar registrado pero su nombre no aparece en el padrón."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Inaangkin ng botante na rehistrado siya pero wala ang pangalan niya sa voter roll."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cử tri cho biết đã đăng ký nhưng tên không xuất hiện trong danh sách cử tri."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选民称自己已登记，但姓名未出现在选民名册中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "选民称自己已登记，但姓名未出现在选民名册中。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "A voter claims they are registered but their name does not appear on the voter roll."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "A voter claims they are registered but their name does not appear on the voter roll."
          }
        }
