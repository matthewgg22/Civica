            "value": "制定你何时、何地投票的计划。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumawa ng plano kung kailan at saan ka boboto."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lập kế hoạch bạn sẽ bỏ phiếu khi nào và ở đâu."
          }
        }
      }
    },
    "app.registration.card.then_vote.bullet_2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review what is on your ballot ahead of time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa con anticipación qué aparece en tu boleta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提前查看选票内容。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Suriin muna ang nilalaman ng iyong balota."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem trước nội dung trên lá phiếu của bạn."
          }
        }
      }
    },
    "app.registration.card.then_vote.bullet_3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm polling location and hours before you go."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma el lugar y horario de votación antes de ir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出发前确认投票地点和开放时间。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumpirmahin ang lokasyon at oras ng botohan bago ka pumunta."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác nhận địa điểm và giờ bỏ phiếu trước khi đi."
          }
        }
      }
    },
    "app.registration.card.then_vote.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once your registration is set, move straight into your voting plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez que tu registro esté listo, pasa directamente a tu plan de votación."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登记完成后，立即进入你的投票计划。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag ayos na ang iyong rehistro, magpatuloy agad sa plano ng pagboto."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi đăng ký xong, chuyển thẳng sang kế hoạch bỏ phiếu của bạn."
          }
        }
      }
    },
    "app.registration.card.then_vote.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then vote"
          }
        },
        "es": {
          "stringUnit": {
