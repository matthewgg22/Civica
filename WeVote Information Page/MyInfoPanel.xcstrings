    "my_info.alert.invalid_zip.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enter a valid 5-digit U.S. ZIP code before continuing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingresa un codigo postal valido de 5 digitos de EE. UU. antes de continuar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续之前请输入有效的美国 5 位邮政编码。"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maglagay muna ng wastong 5-digit U.S. ZIP code bago magpatuloy."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vui lòng nhập mã ZIP Hoa Kỳ hợp lệ gồm 5 chữ số trước khi tiếp tục."
          }
        }
      }
    },
