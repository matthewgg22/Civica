{
  "meta": {
    "name": "US Age Turnout Explorer Dataset",
    "version": "v1.1.0",
    "created_on": "2026-03-25",
    "units": "counts in thousands; rates in percentages",
    "supported_election_types": [
      "presidential",
      "midterm"
    ],
    "unsupported_election_types": [
      {
        "election_type": "primary",
        "status": "not_included_in_v1",
        "reason": "This v1 dataset is built from Census November Voting and Registration Table 3 files, which cover general-election cycles used here for presidential and midterm comparisons."
      }
    ],
    "age_groups": [
      "18+",
      "18–24",
      "25–44",
      "45–64",
      "65–74",
      "75+"
    ],
    "defaults": {
      "default_age_group": "18–24",
      "default_election_type": "presidential",
      "default_year_by_type": {
        "presidential": 2024,
        "midterm": 2022
      }
    },
    "field_notes": {
      "eligible_share_pct": "Share of the U.S. citizen voting-age population in the selected age group.",
      "turnout_rate_pct": "Reported voted / citizen population in the selected age group.",
      "ballot_share_pct": "Share of all reported voters accounted for by the selected age group.",
      "representation_index": "ballot_share_pct / eligible_share_pct; >1 means overrepresented among voters, <1 underrepresented.",
      "representation_gap_points": "ballot_share_pct - eligible_share_pct, in percentage points.",
      "voted_share_of_total_eligible_pct": "Share of the total U.S. citizen voting-age population accounted for by selected-group voters. Computed as voted_thousands divided by all-adults citizen_population_thousands for the same year and election type.",
      "nonvoting_share_of_total_eligible_pct": "Share of the total U.S. citizen voting-age population accounted for by the selected age group that did not vote. Computed as eligible_share_pct minus voted_share_of_total_eligible_pct.",
      "other_eligible_share_pct": "Remaining share of the U.S. citizen voting-age population outside the selected age group. Computed as 100 minus eligible_share_pct.",
      "slider_index": "Discrete slider position for supported age buckets. Null for the 18+ aggregate row."
    },
    "source": {
      "publisher": "U.S. Census Bureau",
      "program": "Current Population Survey Voting and Registration Supplement",
      "table": "Table 3: Reported Voting and Registration by Age, for the United States, Regions, and Divisions",
      "years_used": [
        2014,
        2016,
        2018,
        2020,
        2022,
        2024
      ]
    },
    "interaction_model": {
      "age_control": {
        "type": "discrete_slider",
        "description": "Slider with labeled stops that snaps to supported Census age buckets.",
        "stops": [
          {
            "slider_index": 0,
            "age_group": "18–24",
            "label": "18–24",
            "min_age": 18,
            "max_age": 24,
            "is_open_ended": false
          },
          {
            "slider_index": 1,
            "age_group": "25–44",
            "label": "25–44",
            "min_age": 25,
            "max_age": 44,
            "is_open_ended": false
          },
          {
            "slider_index": 2,
            "age_group": "45–64",
            "label": "45–64",
            "min_age": 45,
            "max_age": 64,
            "is_open_ended": false
          },
          {
            "slider_index": 3,
            "age_group": "65–74",
            "label": "65–74",
            "min_age": 65,
            "max_age": 74,
            "is_open_ended": false
          },
          {
            "slider_index": 4,
            "age_group": "75+",
            "label": "75+",
            "min_age": 75,
            "max_age": null,
            "is_open_ended": true
          }
        ],
        "default_slider_index": 0,
        "all_adults_age_group": "18+"
      },
      "hero_chart": {
        "type": "single_ring_electorate_donut",
        "description": "The full ring represents all eligible U.S. voters. The highlighted arc shows the selected age group’s share of the eligible electorate, split into voted vs did not vote.",
        "segments": [
          {
            "field": "voted_share_of_total_eligible_pct",
            "label": "Selected age group who voted"
          },
          {
            "field": "nonvoting_share_of_total_eligible_pct",
            "label": "Selected age group who did not vote"
          },
          {
            "field": "other_eligible_share_pct",
            "label": "All other eligible voters"
          }
        ]
      }
    }
  },
