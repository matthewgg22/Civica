{
  "name": "@civica/demeter-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Demeter answer engine: verified SNAP Q&A — retrieval over the eCFR corpus + state packs, citation verification, freshness, PII redaction, and the answerQuestion() orchestrator. Shared by apps/web (public chat) and apps/dashboard (staff chat).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./packs": {
      "types": "./src/packs.ts",
      "default": "./src/packs.ts"
    },
    "./system-prompt": {
      "types": "./src/system-prompt.ts",
      "default": "./src/system-prompt.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@civica/snap-rules": "workspace:*",
    "@xenova/transformers": "^2.17.2"
  },
  "devDependencies": {
    "@civica/config": "workspace:*",
    "@eslint/js": "^9",
    "eslint": "^9",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^2.1.5"
  }
}
