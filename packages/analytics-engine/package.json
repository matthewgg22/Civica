{
  "name": "@civica/analytics-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Typed query API for Civica's Tier 3 analytical data (Supabase Storage + DuckDB). Spec: docs/data-architecture.md.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./src/runtime/node.ts",
      "default": "./src/runtime/node.ts"
    },
    "./schemas": {
      "types": "./src/schemas.ts",
      "default": "./src/schemas.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.1.3-alpha.7",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@civica/config": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
