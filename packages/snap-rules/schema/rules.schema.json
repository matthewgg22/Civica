{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SNAP Rules File",
  "description": "State-conditioned document-checklist rules for SNAP enrollment. One file per state. Both TS and Swift runtimes parse identical files.",
  "type": "object",
  "required": ["state_code", "version", "as_of_date", "document_requirements", "flags"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "state_code": { "type": "string", "enum": ["CA", "MA"] },
    "version": { "type": "integer", "enum": [1] },
    "as_of_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "document_requirements": {
      "type": "array",
      "items": { "$ref": "#/definitions/DocumentRequirement" }
    },
    "flags": {
      "type": "array",
      "items": { "$ref": "#/definitions/Flag" }
    }
  },
  "definitions": {
    "Condition": {
      "oneOf": [
        {
          "type": "object",
          "required": ["always"],
          "additionalProperties": false,
          "properties": { "always": { "type": "boolean", "enum": [true] } }
        },
        {
          "type": "object",
          "required": ["answer_key", "equals"],
          "additionalProperties": false,
          "properties": {
            "answer_key": { "type": "string" },
            "equals": { "type": ["string", "number", "boolean"] }
          }
        },
        {
          "type": "object",
          "required": ["answer_key", "contains"],
          "additionalProperties": false,
          "properties": {
            "answer_key": { "type": "string" },
            "contains": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["answer_key", "truthy"],
          "additionalProperties": false,
          "properties": {
            "answer_key": { "type": "string" },
            "truthy": { "type": "boolean", "enum": [true] }
          }
        },
        {
          "type": "object",
          "required": ["answer_key", "one_of"],
          "additionalProperties": false,
          "properties": {
            "answer_key": { "type": "string" },
            "one_of": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
          }
        },
        {
          "type": "object",
          "required": ["household_size_gte"],
          "additionalProperties": false,
          "properties": {
            "household_size_gte": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "DocumentRequirement": {
      "type": "object",
      "required": ["category", "document_kind", "label_en", "label_es", "helper_en", "helper_es", "required_when", "is_required"],
      "additionalProperties": false,
      "properties": {
        "category": { "type": "string", "minLength": 1 },
        "document_kind": {
          "type": "string",
          "enum": ["paystub", "photo_id", "lease", "utility_bill", "bank_statement", "tax_return", "benefit_letter", "other"]
        },
        "label_en": { "type": "string", "minLength": 1 },
        "label_es": { "type": "string", "minLength": 1 },
        "helper_en": { "type": "string", "minLength": 1 },
        "helper_es": { "type": "string", "minLength": 1 },
        "required_when": { "$ref": "#/definitions/Condition" },
        "is_required": { "type": "boolean" },
        "alt_kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["paystub", "photo_id", "lease", "utility_bill", "bank_statement", "tax_return", "benefit_letter", "other"]
          }
        },
        "counsel_note": { "type": "string" }
      }
    },
    "Flag": {
      "type": "object",
      "required": ["key", "trigger_when", "label_en", "label_es", "context_en", "context_es"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "trigger_when": { "$ref": "#/definitions/Condition" },
        "label_en": { "type": "string", "minLength": 1 },
        "label_es": { "type": "string", "minLength": 1 },
        "context_en": { "type": "string", "minLength": 1 },
        "context_es": { "type": "string", "minLength": 1 },
        "counsel_note": { "type": "string" }
      }
    }
  }
}
