{
  "name": "@civica/snap-qc-engine",
  "version": "0.3.0",
  "private": true,
  "description": "QC engine: rule logic, defensibility scoring, evidence package builder, and citations for SNAP verification flows. Tenant-agnostic; pure compute; no network.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:golden": "vitest run test/golden.test.ts",
    "regenerate:goldens": "tsx scripts/regenerate-goldens.ts",
    "cli": "tsx cli/snap-qc-cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@civica/snap-calculator": "workspace:*",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.5.3",
    "vitest": "^2.1.9"
  }
}
