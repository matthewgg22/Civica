NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_BASE_URL=https://civica-enrollment-api.civica-api.workers.dev

# E2E test credentials (Playwright) — pre-created test account with email+password auth
E2E_TEST_EMAIL=e2e@example.com
E2E_TEST_PASSWORD=test-password-here

# Sentry error monitoring
NEXT_PUBLIC_SENTRY_DSN=https://your-key@sentry.io/project-id
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=civica-web
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Injected automatically by Vercel — no need to set manually
# NEXT_PUBLIC_VERCEL_ENV=production|preview|development
