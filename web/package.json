    "@supabase/supabase-js": "^2.105.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "negotiator": "^1.0.0",
    "next": "16.2.6",
    "next-intl": "^4.12.0",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.4",
